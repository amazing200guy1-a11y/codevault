{
  "name": "codevault",
  "version": "1.0.0",
  "description": "AI-powered code vulnerability scanner with SHA-256 forensic audit chain — Kiroween 2026 Frankenstein entry",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
